{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alberts-electric",
  "compatibility_date": "2026-07-27",
  "main": "src/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "albertselectric.net", "custom_domain": true },
    { "pattern": "www.albertselectric.net", "custom_domain": true },
    { "pattern": "lcrccmissouri.org", "custom_domain": true },
    { "pattern": "www.lcrccmissouri.org", "custom_domain": true },
    { "pattern": "lcrccmissouri.com", "custom_domain": true },
    { "pattern": "www.lcrccmissouri.com", "custom_domain": true },
    { "pattern": "lcrccmissouri.net", "custom_domain": true },
    { "pattern": "www.lcrccmissouri.net", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "REVIEWS_KV", "id": "9c628783acb748d7bf0b2b3fd2bcdb96" },
    { "binding": "HIVE_LOGS_KV", "id": "234df894a9884958bad61da107833b8a" },
    { "binding": "VISITS_KV", "id": "a65027ec56264816bf65b053512c1f8d" },
    { "binding": "LCRCC_SIGNUPS_KV", "id": "85561c7bd6984fcab6edbb36a1faf378" }
  ],
  "d1_databases": [
    { "binding": "LCRCC_DB", "database_name": "lcrcc_contributions", "database_id": "d8a1c719-2d83-435f-a190-9cfbabef1a06" }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["lcrcc@albertselectric.net", "contactform@lcrccmissouri.org"] }
  ],
  "vars": {
    "GOOGLE_PLACE_ID": "ChIJVeZ2_mwTzooRBugM6zEur9c",
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51U8NT6Pjl3Vdmm74XkXUzuLus6EBSO1MDKPjDyqWqV0zG3zXbGvi6r75CyUQj6HJPfdiXniWCxIt4EUvnGTnpMMG00Hhw2A7Zv"
  }
}
